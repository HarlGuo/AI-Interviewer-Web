# Copy this file to backend/.env. Never commit the real value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Local development keeps existing one-person testing working. Production must use supabase.
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 仅供后端使用，绝不能写入 EXPO_PUBLIC_* 或提交到 Git。
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
APP_VERSION=development
AGENT_VERSION=interview-graph-v1
PROMPT_VERSION=interview-prompts-v1
SKILL_VERSION=resume-interview-skills-v1
RUBRIC_VERSION=behavior-anchor-v1
