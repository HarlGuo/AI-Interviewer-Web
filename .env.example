# Public backend address only. Never put DEEPSEEK_API_KEY in an EXPO_PUBLIC_* variable.
# iOS simulator:
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Leave both blank for the existing one-person local development mode.
# For registered users, copy the Project URL and publishable key from Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Physical phone example: http://YOUR_MAC_LAN_IP:8000
